<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the session is Keystore-bound and would not open elsewhere anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (spike S-C0): the STT Lab. Release builds don't merge this file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The release Folio already defines this signature permission with the release key.
         Android refuses a differently signed app that redefines it
         (INSTALL_FAILED_DUPLICATE_PERMISSION), so the debug build doesn't define it and can sit
         next to Folio on the phone. Folio can't read a debug build's connection anyway: the
         signers differ. -->
    <permission
        android:name="com.folio.permission.HERMES"
        tools:node="remove" />

    <application>
        <!-- Off-call start probe (spec v2 §14 item 14): device test only, never started by the app. -->
        <service
            android:name=".probe.ProbeHolderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".probe.ProbeTargetService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Debug probe: whether the off-call service may start after hang-up." />
        </service>
        <activity
            android:name=".lab.SttLabActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:label="@string/stt_lab_label"
            android:taskAffinity="com.folio.hermeslive.lab"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
